# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Flask environment (development, production, testing)
FLASK_ENV=development

# Secret key for session management (generate a random string for production)
SECRET_KEY=your-secret-key-here

# Database URL
# Choose one of the following database configurations:

# SQLite (file-based, good for development)
# DATABASE_URL=sqlite:///instance/app.db

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://username:password@localhost/dbname

# PostgreSQL with custom port
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# MySQL example
# DATABASE_URL=mysql://username:password@localhost/dbname

# Note: Make sure to install the appropriate database driver:
# - SQLite: built-in with Python
# - PostgreSQL: pip install psycopg2-binary
# - MySQL: pip install mysqlclient

# Server port
PORT=5000

# Enable debug mode (set to False in production)
DEBUG=True
